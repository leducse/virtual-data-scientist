# Copy values into your shell environment or a local .env file you manage.
# Do not commit real credentials.

# Agent mode: auto, mock, or bedrock
AGENT_MODE=auto

# Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Optional environment-configured Postgres data source
POSTGRES_NAME=Environment Postgres
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer

# Optional S3 upload path for CSV files
CSV_STORAGE=local
S3_UPLOAD_BUCKET=
S3_UPLOAD_PREFIX=virtual-data-scientist/uploads
