{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Virtual Data Scientist isolated container development environment",
  "Parameters": {
    "ImageUri": {
      "Type": "String",
      "Default": ""
    },
    "ModelId": {
      "Type": "String",
      "Default": "us.amazon.nova-pro-v1:0"
    },
    "ModelResources": {
      "Type": "CommaDelimitedList"
    },
    "ReleaseId": {
      "Type": "String",
      "Default": "dev-v2"
    },
    "WebOrigin": {
      "Type": "String",
      "Default": ""
    },
    "AlternateOrigin": {
      "Type": "String",
      "Default": ""
    },
    "PreviousWebOrigin": {
      "Type": "String",
      "Default": ""
    }
  },
  "Conditions": {
    "HasPreviousWebOrigin": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "PreviousWebOrigin"
            },
            ""
          ]
        }
      ]
    },
    "HasAlternateOrigin": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AlternateOrigin"
            },
            ""
          ]
        }
      ]
    },
    "HasImage": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "ImageUri"
            },
            ""
          ]
        }
      ]
    },
    "HasWebOrigin": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "WebOrigin"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Images": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "Properties": {
        "RepositoryName": "virtual-data-scientist-v2-dev",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      }
    },
    "Data": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "CorsConfiguration": {
          "Fn::If": [
            "HasWebOrigin",
            {
              "CorsRules": [
                {
                  "AllowedOrigins": [
                    {
                      "Ref": "WebOrigin"
                    },
                    {
                      "Fn::If": [
                        "HasAlternateOrigin",
                        {
                          "Ref": "AlternateOrigin"
                        },
                        {
                          "Ref": "AWS::NoValue"
                        }
                      ]
                    },
                    {
                      "Fn::If": [
                        "HasPreviousWebOrigin",
                        {
                          "Ref": "PreviousWebOrigin"
                        },
                        {
                          "Ref": "AWS::NoValue"
                        }
                      ]
                    }
                  ],
                  "AllowedMethods": [
                    "POST"
                  ],
                  "AllowedHeaders": [
                    "*"
                  ],
                  "ExposedHeaders": [
                    "ETag"
                  ],
                  "MaxAge": 300
                }
              ]
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "DevelopmentRetention",
              "Status": "Enabled",
              "ExpirationInDays": 7,
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      }
    },
    "DataPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Data"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Data",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Data.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "State": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "TimeToLiveSpecification": {
          "AttributeName": "expires_at",
          "Enabled": true
        }
      }
    },
    "RuntimeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "VdsV2DevRuntimeRole",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "bedrock-agentcore.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:runtime/*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "VdsDevelopmentDataAndExecution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Data.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Data",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "State",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Images",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel",
                    "bedrock:InvokeModelWithResponseStream"
                  ],
                  "Resource": {
                    "Ref": "ModelResources"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:StartCodeInterpreterSession",
                    "bedrock-agentcore:InvokeCodeInterpreter",
                    "bedrock-agentcore:StopCodeInterpreterSession"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:aws:code-interpreter/aws.codeinterpreter.v1"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents",
                    "logs:DescribeLogStreams"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/bedrock-agentcore/runtimes/VirtualDataScientistV2Dev*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Runtime": {
      "Type": "AWS::BedrockAgentCore::Runtime",
      "Condition": "HasImage",
      "Properties": {
        "AgentRuntimeName": "VirtualDataScientistV2Dev",
        "AgentRuntimeArtifact": {
          "ContainerConfiguration": {
            "ContainerUri": {
              "Ref": "ImageUri"
            }
          }
        },
        "RoleArn": {
          "Fn::GetAtt": [
            "RuntimeRole",
            "Arn"
          ]
        },
        "NetworkConfiguration": {
          "NetworkMode": "PUBLIC"
        },
        "ProtocolConfiguration": "HTTP",
        "LifecycleConfiguration": {
          "IdleRuntimeSessionTimeout": 60,
          "MaxLifetime": 900
        },
        "EnvironmentVariables": {
          "VDS_DATA_BUCKET": {
            "Ref": "Data"
          },
          "VDS_STATE_TABLE": {
            "Ref": "State"
          },
          "VDS_MODEL_ID": {
            "Ref": "ModelId"
          },
          "VDS_RELEASE": {
            "Ref": "ReleaseId"
          }
        }
      }
    },
    "Dashboard": {
      "Type": "AWS::CloudWatch::Dashboard",
      "Condition": "HasImage",
      "Properties": {
        "DashboardName": "vds-v2-development",
        "DashboardBody": {
          "Fn::Sub": "{\"start\": \"-PT3H\", \"periodOverride\": \"inherit\", \"widgets\": [{\"type\": \"text\", \"x\": 0, \"y\": 0, \"width\": 24, \"height\": 2, \"properties\": {\"markdown\": \"# VDS development operations\\nPrivate operator view. Low-volume rates need sample counts. No traffic is not a successful analysis. Usage is not reconciled billing. Logs exclude analysis content.\"}}, {\"type\": \"metric\", \"x\": 0, \"y\": 2, \"width\": 12, \"height\": 6, \"properties\": {\"title\": \"Terminal analysis events\", \"region\": \"${AWS::Region}\", \"period\": 300, \"stat\": \"Sum\", \"metrics\": [[\"DecisionLayer/VDS\", \"stage_events\", \"environment\", \"development\", \"stage\", \"analysis\", \"status\", \"completed\", {\"label\": \"completed\"}], [\"DecisionLayer/VDS\", \"stage_events\", \"environment\", \"development\", \"stage\", \"analysis\", \"status\", \"failed\", {\"label\": \"failed\"}], [\"DecisionLayer/VDS\", \"stage_events\", \"environment\", \"development\", \"stage\", \"analysis\", \"status\", \"cancelled\", {\"label\": \"cancelled\"}]]}}, {\"type\": \"metric\", \"x\": 12, \"y\": 2, \"width\": 12, \"height\": 6, \"properties\": {\"title\": \"Completed analysis duration (milliseconds)\", \"region\": \"${AWS::Region}\", \"period\": 300, \"metrics\": [[\"DecisionLayer/VDS\", \"duration_ms\", \"environment\", \"development\", \"stage\", \"analysis\", \"status\", \"completed\", {\"stat\": \"p50\", \"label\": \"p50\", \"yAxis\": \"left\"}], [\"DecisionLayer/VDS\", \"duration_ms\", \"environment\", \"development\", \"stage\", \"analysis\", \"status\", \"completed\", {\"stat\": \"p95\", \"label\": \"p95\", \"yAxis\": \"left\"}], [\"DecisionLayer/VDS\", \"duration_ms\", \"environment\", \"development\", \"stage\", \"analysis\", \"status\", \"completed\", {\"stat\": \"SampleCount\", \"label\": \"SampleCount\", \"yAxis\": \"right\"}]]}}, {\"type\": \"metric\", \"x\": 0, \"y\": 8, \"width\": 12, \"height\": 6, \"properties\": {\"title\": \"Web gateway errors and throttles\", \"region\": \"${AWS::Region}\", \"period\": 300, \"stat\": \"Sum\", \"metrics\": [[\"AWS/Lambda\", \"Errors\", \"FunctionName\", \"vds-v2-dev-web\"], [\"AWS/Lambda\", \"Throttles\", \"FunctionName\", \"vds-v2-dev-web\"]]}}, {\"type\": \"metric\", \"x\": 12, \"y\": 8, \"width\": 12, \"height\": 6, \"properties\": {\"title\": \"Web gateway duration\", \"region\": \"${AWS::Region}\", \"period\": 300, \"stat\": \"p95\", \"metrics\": [[\"AWS/Lambda\", \"Duration\", \"FunctionName\", \"vds-v2-dev-web\"]]}}, {\"type\": \"log\", \"x\": 0, \"y\": 14, \"width\": 24, \"height\": 7, \"properties\": {\"title\": \"Stage durations and quality gate outcomes (content-free)\", \"region\": \"${AWS::Region}\", \"view\": \"table\", \"query\": \"SOURCE logGroups(namePrefix: ['/aws/bedrock-agentcore/runtimes/VirtualDataScientistV2Dev']) | filter event = 'workflow_stage' | stats count(*) as events, pct(duration_ms, 95) as p95_ms by stage, status | sort stage asc\"}}, {\"type\": \"log\", \"x\": 0, \"y\": 21, \"width\": 24, \"height\": 6, \"properties\": {\"title\": \"Recent operational errors\", \"region\": \"${AWS::Region}\", \"view\": \"table\", \"query\": \"SOURCE logGroups(namePrefix: ['/aws/bedrock-agentcore/runtimes/VirtualDataScientistV2Dev']) | filter event = 'dependency_error' | fields @timestamp, run_id, stage, error_code | sort @timestamp desc | limit 30\"}}, {\"type\": \"log\", \"x\": 0, \"y\": 27, \"width\": 24, \"height\": 6, \"properties\": {\"title\": \"Measured model usage by role (not a bill)\", \"region\": \"${AWS::Region}\", \"view\": \"table\", \"query\": \"SOURCE logGroups(namePrefix: ['/aws/bedrock-agentcore/runtimes/VirtualDataScientistV2Dev']) | filter event = 'model_usage' | stats sum(input_tokens) as input_tokens, sum(output_tokens) as output_tokens, count(*) as measured_calls by stage\"}}]}"
        }
      }
    },
    "AnalysisFailures": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "vds-v2-dev-analysis-failures",
        "AlarmDescription": "Three failed analyses in five minutes. Inspect the private dashboard and correlate run IDs; never blindly replay unknown executions.",
        "Namespace": "DecisionLayer/VDS",
        "MetricName": "stage_events",
        "Dimensions": [
          {
            "Name": "environment",
            "Value": "development"
          },
          {
            "Name": "stage",
            "Value": "analysis"
          },
          {
            "Name": "status",
            "Value": "failed"
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 3,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "DataBucket": {
      "Value": {
        "Ref": "Data"
      }
    },
    "StateTable": {
      "Value": {
        "Ref": "State"
      }
    },
    "ImageRepository": {
      "Value": {
        "Fn::GetAtt": [
          "Images",
          "RepositoryUri"
        ]
      }
    },
    "RuntimeArn": {
      "Condition": "HasImage",
      "Value": {
        "Fn::GetAtt": [
          "Runtime",
          "AgentRuntimeArn"
        ]
      }
    }
  }
}
